# Helios Secure Vault Configuration
# This file should be copied to .env.local and filled with your actual values.
# Never commit .env.local to Git.

# Master key for encryption (32 bytes in hex format)
HELIOS_MASTER_KEY=

# API Keys for external services
STRIPE_SECRET_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GITHUB_TOKEN=
GOOGLE_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Browser automation configuration
BROWSER_USE_PROXY=
BROWSER_USE_HEADLESS=true

# Financial configuration
FINANCIAL_DEFAULT_CURRENCY=USD
FINANCIAL_MINIMUM_BALANCE=500

# Security and monitoring
SECURITY_AUDIT_LEVEL=HIGH
MONITORING_ENABLED=true