# ============================================================
# HELIOS CORE v2.0.0 - Orquestador Frugal de Recursos
# Configuracion de Entorno
# ============================================================

# --- SEGURIDAD CRITICA ---
HELIOS_MASTER_KEY=tu_clave_maestra_muy_segura_de_32_chars_min
HELIOS_GATEWAY_TOKEN=tu_token_de_api_seguro_16_chars_min

# --- ENTORNO ---
HELIOS_ENV=development
HELIOS_GATEWAY_PORT=3000
HELIOS_GATEWAY_HOST=0.0.0.0

# --- LLM LOCAL (Ollama) ---
LOCAL_LLM_ENDPOINT=http://localhost:11434
LOCAL_LLM_MODEL=llama3.2

# --- APIs EXTERNAS (Opcionales pero recomendadas) ---
OPENROUTER_API_KEY=sk-or-v1-tu_api_key_aqui

# --- FINANZAS ---
HELIOS_INITIAL_BALANCE=1000
HELIOS_MINIMUM_BALANCE=500
HELIOS_HUMAN_CUT_PERCENT=20
HELIOS_CURRENCY=USD
HELIOS_MAX_LOSS_KILL_SWITCH=1000

# --- AUTONOMIA ---
# 0 = Aprobacion Total (todo requiere humano)
# 1 = Notificar (notifica acciones importantes)
# 2 = Automatico con Excepciones
# 3 = Independiente
# 4 = Total Autonomia
HELIOS_AUTONOMY_LEVEL=4

# --- RECURSOS ---
HELIOS_MAX_AGENTS=10
HELIOS_AGENT_MEMORY_LIMIT_MB=512
HELIOS_HEALTH_CHECK_INTERVAL_MS=30000
HELIOS_AUDIT_RETENTION_DAYS=365

# --- ALMACENAMIENTO ---
HELIOS_STATE_DIR=./.helios
HELIOS_LEDGER_PATH=./.helios/ledger.db

# --- PAGOS (Opcional - para ingresos autonomos) ---
STRIPE_SECRET_KEY=sk_test_tu_stripe_key
CRYPTO_WALLET_SEED=tu_seed_phrase_para_wallet_crypto
