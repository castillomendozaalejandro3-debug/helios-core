# Helios Configuration File
# Copy this file to .env.local and fill in the required values
# This file is ignored by git (.gitignore includes .env.local)

# CORE SECURITY
HELIOS_MASTER_KEY=your-32-byte-master-key-here
VAULT_PATH=./.helios_vault.enc
ENCRYPTION_ALGORITHM=AES-256-GCM

# LLM CONFIGURATION
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
LLM_BASE_URL=https://api.openrouter.ai/v1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# FINANCIAL CONFIGURATION
STRIPE_SECRET_KEY=your-stripe-secret-key-here
REVENUE_THRESHOLD=1000.0
CURRENCY=USD

# BROWSER CONFIGURATION
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000
BROWSER_USER_AGENT=Helios Browser Agent

# LOCAL DEVELOPMENT (optional)
LOCAL_LLM_ENDPOINT=http://localhost:11434
LOCAL_LLM_MODEL=llama3.1:latest

# MEMORY CONFIGURATION
MEMORY_DB_PATH=./lancedb
MEMORY_VECTOR_DIM=384

# SECURE VAULT CONFIGURATION
VAULT_ENCRYPTION_KEY=your-vault-encryption-key-here
VAULT_IV=your-vault-iv-here

# ADDITIONAL CONFIGURATION
LOG_LEVEL=info
DEBUG_MODE=false