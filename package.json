{
  "name": "helios-core",
  "version": "2.2.0",
  "description": "Helios - Orquestador Frugal de Recursos v2.2.0. Logger estructurado, MemoryEngine LRU, BudgetManager persistencia, CloneCommunicator locks. Entidad de Software Autonoma.",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "boot-test": "tsx src/boot-test.ts",
    "ui:build": "mkdir -p dist/ui && cp -r ui/* dist/ui/",
    "ui:dev": "npx serve ui -p 8080",
    "health": "curl -s http://localhost:3000/health || echo 'Helios no esta corriendo'",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "autonomous",
    "agent",
    "helios",
    "financial-autonomy",
    "multi-agent"
  ],
  "author": "Equipo de Arquitectura Helios",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "compression": "^1.8.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "node-cron": "^3.0.3",
    "playwright": "^1.45.0",
    "stripe": "^17.0.0",
    "uuid": "^10.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.11",
    "tsx": "^4.16.0",
    "typescript": "^5.9.3"
  }
}
